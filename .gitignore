# secrets - never commit
.env
**/.env
.env.*
!.env.example

# personal data - never commit. Default-deny the whole directory (not just
# exact filenames) so a stray copy like "master_profile-1.md" or
# "candidate (1).json" can never slip through an exact-name rule again.
multi_tool_agent/profile/*
!multi_tool_agent/profile/*.example.*
multi_tool_agent/resume/*
!multi_tool_agent/resume/README.txt

# python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# adk local state
.adk/

# editor/os
.DS_Store
Thumbs.db

# backups
*.bak

# logs
*.log
